        <mxCell id="note" value="Cross-service IDs are references only: there are no database foreign keys between service schemas." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;fontStyle=1;" vertex="1" parent="1">
